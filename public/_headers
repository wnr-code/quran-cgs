/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://mirror-uploads.trakteer.id; font-src 'self'; media-src 'self' blob: https:; connect-src 'self' https:; worker-src 'self'; manifest-src 'self'; frame-src https:; object-src 'none'; base-uri 'self'; form-action 'self'

# Berkas publik boleh diambil dari alamat cadangan/utama (lihat src/services/failover.js & sw.js).
/assets/*
  Access-Control-Allow-Origin: *

/data/*
  Access-Control-Allow-Origin: *

/fonts/*
  Access-Control-Allow-Origin: *

/icons/*
  Access-Control-Allow-Origin: *

/version.json
  Access-Control-Allow-Origin: *

/index.html
  Access-Control-Allow-Origin: *

/
  Access-Control-Allow-Origin: *

/sw.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/version.json
  Cache-Control: no-store

/manifest.webmanifest
  Cache-Control: no-cache

/icons/*
  Cache-Control: public, max-age=86400

/og-image.jpg
  Cache-Control: public, max-age=86400

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: public, max-age=3600
