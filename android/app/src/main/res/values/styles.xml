<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.QuranKu.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/quranku_splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.QuranKu</item>
    </style>

    <style name="Theme.QuranKu" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#C9A961</item>
        <item name="android:statusBarColor">#103B31</item>
        <item name="android:navigationBarColor">#F6F5F0</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#F6F5F0</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
