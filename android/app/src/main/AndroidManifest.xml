<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Approximate location is requested only when the user taps “Gunakan lokasi saya”. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Lokasi opsional: jangan sampai Play Store menyaring perangkat tanpa GPS (mis. tablet/TV box). -->
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Beranda: https://quran.cgs.my.id/ -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="quran.cgs.my.id" android:path="/" />
            </intent-filter>

            <!-- Halaman satu segmen (/kiblat, /infaq, /salat, …). Didaftar satu per satu
                 supaya berkas statis seperti /privacy.html tetap terbuka di peramban:
                 kebijakan privasi harus bisa dibaca dari tautan Play Store. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="quran.cgs.my.id" android:path="/quran" />
                <data android:scheme="https" android:host="quran.cgs.my.id" android:path="/cari" />
                <data android:scheme="https" android:host="quran.cgs.my.id" android:path="/murottal" />
                <data android:scheme="https" android:host="quran.cgs.my.id" android:path="/bookmark" />
                <data android:scheme="https" android:host="quran.cgs.my.id" android:path="/lainnya" />
                <data android:scheme="https" android:host="quran.cgs.my.id" android:path="/salat" />
                <data android:scheme="https" android:host="quran.cgs.my.id" android:path="/kalender" />
                <data android:scheme="https" android:host="quran.cgs.my.id" android:path="/asmaul-husna" />
                <data android:scheme="https" android:host="quran.cgs.my.id" android:path="/doa" />
                <data android:scheme="https" android:host="quran.cgs.my.id" android:path="/tasbih" />
                <data android:scheme="https" android:host="quran.cgs.my.id" android:path="/kiblat" />
                <data android:scheme="https" android:host="quran.cgs.my.id" android:path="/target" />
                <data android:scheme="https" android:host="quran.cgs.my.id" android:path="/offline" />
                <data android:scheme="https" android:host="quran.cgs.my.id" android:path="/infaq" />
                <data android:scheme="https" android:host="quran.cgs.my.id" android:path="/pengaturan" />
                <data android:scheme="https" android:host="quran.cgs.my.id" android:path="/tentang" />
                <data android:scheme="https" android:host="quran.cgs.my.id" android:path="/sumber" />
                <data android:scheme="https" android:host="quran.cgs.my.id" android:path="/notifikasi" />
                <data android:scheme="https" android:host="quran.cgs.my.id" android:path="/lanjut" />
            </intent-filter>

            <!-- Cadangan: domain Worker (quran-cgs.appwnr.workers.dev). Tautan yang dibagikan
                 dalam bentuk domain cadangan juga membuka aplikasi. Berkas assetlinks.json
                 disajikan Worker yang sama di domain ini, jadi verifikasi bisa lolos.
                 Catatan: di Android 7-11 (verifikasi "legacy") semua host harus lolos —
                 bila domain cadangan tidak menyajikan assetlinks.json yang sama, tautan
                 DOMAIN UTAMA ikut berhenti terbuka di aplikasi. Karena itu
                 `npm run check:deploy` memeriksa sidik jari kedua domain. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="quran-cgs.appwnr.workers.dev" android:path="/" />
                <data android:scheme="https" android:host="quran-cgs.appwnr.workers.dev" android:path="/quran" />
                <data android:scheme="https" android:host="quran-cgs.appwnr.workers.dev" android:path="/cari" />
                <data android:scheme="https" android:host="quran-cgs.appwnr.workers.dev" android:path="/murottal" />
                <data android:scheme="https" android:host="quran-cgs.appwnr.workers.dev" android:path="/bookmark" />
                <data android:scheme="https" android:host="quran-cgs.appwnr.workers.dev" android:path="/lainnya" />
                <data android:scheme="https" android:host="quran-cgs.appwnr.workers.dev" android:path="/salat" />
                <data android:scheme="https" android:host="quran-cgs.appwnr.workers.dev" android:path="/kalender" />
                <data android:scheme="https" android:host="quran-cgs.appwnr.workers.dev" android:path="/asmaul-husna" />
                <data android:scheme="https" android:host="quran-cgs.appwnr.workers.dev" android:path="/doa" />
                <data android:scheme="https" android:host="quran-cgs.appwnr.workers.dev" android:path="/tasbih" />
                <data android:scheme="https" android:host="quran-cgs.appwnr.workers.dev" android:path="/kiblat" />
                <data android:scheme="https" android:host="quran-cgs.appwnr.workers.dev" android:path="/target" />
                <data android:scheme="https" android:host="quran-cgs.appwnr.workers.dev" android:path="/offline" />
                <data android:scheme="https" android:host="quran-cgs.appwnr.workers.dev" android:path="/infaq" />
                <data android:scheme="https" android:host="quran-cgs.appwnr.workers.dev" android:path="/pengaturan" />
                <data android:scheme="https" android:host="quran-cgs.appwnr.workers.dev" android:path="/tentang" />
                <data android:scheme="https" android:host="quran-cgs.appwnr.workers.dev" android:path="/sumber" />
                <data android:scheme="https" android:host="quran-cgs.appwnr.workers.dev" android:path="/notifikasi" />
                <data android:scheme="https" android:host="quran-cgs.appwnr.workers.dev" android:path="/lanjut" />
            </intent-filter>

            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="quran-cgs.appwnr.workers.dev" android:pathPrefix="/surah/" />
                <data android:scheme="https" android:host="quran-cgs.appwnr.workers.dev" android:pathPrefix="/tafsir/" />
                <data android:scheme="https" android:host="quran-cgs.appwnr.workers.dev" android:pathPrefix="/doa/" />
            </intent-filter>

            <!-- Jalur bertingkat: /surah/2, /surah/2/255, /tafsir/2/255, /doa/harian.
                 pathPrefix dipakai, bukan pathPattern: PatternMatcher Android membuat ".*"
                 hanya cocok dengan satu karakter, sehingga pola "/.*/.*" tidak pernah cocok
                 dengan /surah/2/255 dan tautan itu terlempar ke peramban. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="quran.cgs.my.id" android:pathPrefix="/surah/" />
                <data android:scheme="https" android:host="quran.cgs.my.id" android:pathPrefix="/tafsir/" />
                <data android:scheme="https" android:host="quran.cgs.my.id" android:pathPrefix="/doa/" />
            </intent-filter>

        </activity>

        <receiver
            android:name=".PrayerAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name=".PrayerNotificationOpenReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name=".PrayerBootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.USER_UNLOCKED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".PrayerPlaybackService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

</manifest>
